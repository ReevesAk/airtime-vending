# Copy to .env and adjust. Every variable is optional for local development
# (DJANGO_DEBUG defaults to true); DJANGO_SECRET_KEY is required once
# DJANGO_DEBUG is false -- service/config/settings.py refuses to start otherwise.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=airtime
POSTGRES_USER=airtime
POSTGRES_PASSWORD=airtime
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

API_KEY=dev-api-key

OPERATOR_BASE_URL=http://localhost:9000
OPERATOR_CALL_TIMEOUT_SECONDS=4.5
USSD_SESSION_TTL_SECONDS=5
